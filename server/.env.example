################################
# STRIPE — keep real keys in server/.env only (never commit .env)
################################
# Test keys (dashboard toggle ON)
STRIPE_SECRET_KEY_TEST=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_your_key_here

# Live keys (dashboard toggle OFF)
STRIPE_SECRET_KEY_LIVE=sk_live_your_key_here
STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_your_key_here

# Legacy / fallback names (optional)
STRIPE_SECRET_KEY=sk_test_your_key_here
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

################################
# FIREBASE — SERVER (Admin SDK)
################################
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

################################
# FIREBASE — CLIENT (Web SDK)
################################
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
REACT_APP_FIREBASE_VAPID_KEY=

################################
# APP
################################
PORT=5001
REACT_APP_API_BASE=http://localhost:5001
